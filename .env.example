# Copia este archivo a .env y completa los valores solo si vas a operar en vivo.
# Nunca subas .env al repositorio. El modo paper no necesita claves.

# Opt-in explícito. Déjalo en false salvo que entiendas que se enviarán órdenes reales.
CRYPTOBOT_ENABLE_LIVE=false

# Credenciales del exchange. El programa las lee únicamente desde el entorno.
CRYPTOBOT_API_KEY=
CRYPTOBOT_API_SECRET=

# Algunas cuentas (por ejemplo OKX) exigen una passphrase.
CRYPTOBOT_API_PASSWORD=
